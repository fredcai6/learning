# Copy to deploy/.env. That file is never committed.

# The proxy stack's internal network (docker network ls).
LEARN_SITE_NETWORK=

# Host paths.
LEARN_VAULT_DIR=
LEARN_ARCHIVE_DIR=
LEARN_STATE_DIR=
LEARN_CERTS_DIR=

# The user the container runs as: the owner of LEARN_STATE_DIR (id -u, id -g).
LEARN_UID=1000
LEARN_GID=1000

# Cloudflare Access: the application's audience tag, and your team domain.
#   Zero Trust → Access controls → Applications → (the app) → Overview: "Application Audience (AUD) Tag"
LEARN_ACCESS_AUD=
LEARN_ACCESS_ISSUER=https://<team>.cloudflareaccess.com

# The path the proxy serves the site under, and the learners' time zone (when "today" starts).
LEARN_BASE_URL=/learn
LEARN_TZ=UTC

# New cards per learner per day.
LEARN_NEW_PER_DAY=10
